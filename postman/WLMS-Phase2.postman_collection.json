{
  "info": {
    "_postman_id": "wlms-phase2-api-tests",
    "name": "WLMS Phase 2 API Tests",
    "description": "15 solicitudes automatizadas. El flujo inicia sesión, conserva el JWT y consulta los recursos principales sin modificar datos.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "exec": [
          "pm.test('Response time is below 3000 ms', () => pm.expect(pm.response.responseTime).to.be.below(3000));",
          "pm.test('Response is JSON', () => pm.expect(pm.response.headers.get('Content-Type') || '').to.include('application/json'));"
        ]
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:8000" },
    { "key": "username", "value": "" },
    { "key": "password", "value": "" },
    { "key": "accessToken", "value": "" },
    { "key": "currentRole", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "item": [
    {
      "name": "01 - Health check",
      "auth": { "type": "noauth" },
      "request": { "method": "GET", "url": "{{baseUrl}}/" },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Status 200', () => pm.response.to.have.status(200));",
        "const body = pm.response.json();",
        "pm.test('Backend identity is present', () => pm.expect(body).to.have.property('message', 'WLMS backend'));"
      ] } }]
    },
    {
      "name": "02 - Reject invalid login",
      "auth": { "type": "noauth" },
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
        "body": { "mode": "urlencoded", "urlencoded": [
          { "key": "username", "value": "__invalid_phase2_user__" },
          { "key": "password", "value": "invalid-password" }
        ] },
        "url": "{{baseUrl}}/auth/login"
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Status 401', () => pm.response.to.have.status(401));",
        "pm.test('Error detail is returned', () => pm.expect(pm.response.json()).to.have.property('detail'));"
      ] } }]
    },
    {
      "name": "03 - Reject unauthenticated profile",
      "auth": { "type": "noauth" },
      "request": { "method": "GET", "url": "{{baseUrl}}/auth/me" },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Status 401', () => pm.response.to.have.status(401));",
        "pm.test('Authentication error has detail', () => pm.expect(pm.response.json()).to.have.property('detail'));"
      ] } }]
    },
    {
      "name": "04 - Login and store token",
      "auth": { "type": "noauth" },
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
        "body": { "mode": "urlencoded", "urlencoded": [
          { "key": "username", "value": "{{username}}" },
          { "key": "password", "value": "{{password}}" }
        ] },
        "url": "{{baseUrl}}/auth/login"
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Status 200', () => pm.response.to.have.status(200));",
        "const body = pm.response.json();",
        "pm.test('Token schema is valid', () => { pm.expect(body).to.have.keys('access_token', 'token_type'); pm.expect(body.access_token).to.be.a('string').and.not.empty; pm.expect(body.token_type).to.eql('bearer'); });",
        "pm.collectionVariables.set('accessToken', body.access_token);"
      ] } }]
    },
    {
      "name": "05 - Current user",
      "request": { "method": "GET", "url": "{{baseUrl}}/auth/me" },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Status 200', () => pm.response.to.have.status(200));",
        "const body = pm.response.json();",
        "pm.test('User schema is valid', () => { pm.expect(body.user_id).to.be.a('number'); pm.expect(body.username).to.be.a('string'); pm.expect(body.role).to.be.a('string'); });",
        "pm.collectionVariables.set('currentRole', body.role);"
      ] } }]
    },
    {
      "name": "06 - Items",
      "request": { "method": "GET", "url": "{{baseUrl}}/items/" },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Status 200', () => pm.response.to.have.status(200));",
        "const body = pm.response.json();",
        "pm.test('Items are an array', () => pm.expect(body).to.be.an('array'));",
        "pm.test('Item schema is valid when present', () => { if (body.length) { pm.expect(body[0]).to.include.keys('item_id','item_name','reorder_level','uom_symbol','is_active'); } });"
      ] } }]
    },
    {
      "name": "07 - Units of measure",
      "request": { "method": "GET", "url": "{{baseUrl}}/uoms/" },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Status 200', () => pm.response.to.have.status(200));",
        "pm.test('UOM response is an array', () => pm.expect(pm.response.json()).to.be.an('array'));"
      ] } }]
    },
    {
      "name": "08 - Suppliers",
      "request": { "method": "GET", "url": "{{baseUrl}}/suppliers/" },
      "event": [{ "listen": "test", "script": { "exec": [
        "const allowed = ['Administrator', 'Warehouse Staff'].includes(pm.collectionVariables.get('currentRole'));",
        "pm.test('Status matches warehouse authorization', () => pm.response.to.have.status(allowed ? 200 : 403));",
        "pm.test('Suppliers content matches authorization', () => { const body = pm.response.json(); allowed ? pm.expect(body).to.be.an('array') : pm.expect(body).to.have.property('detail'); });"
      ] } }]
    },
    {
      "name": "09 - Customers",
      "request": { "method": "GET", "url": "{{baseUrl}}/customers/" },
      "event": [{ "listen": "test", "script": { "exec": [
        "const allowed = ['Administrator', 'Logistics Staff'].includes(pm.collectionVariables.get('currentRole'));",
        "pm.test('Status matches logistics authorization', () => pm.response.to.have.status(allowed ? 200 : 403));",
        "pm.test('Customers content matches authorization', () => { const body = pm.response.json(); allowed ? pm.expect(body).to.be.an('array') : pm.expect(body).to.have.property('detail'); });"
      ] } }]
    },
    {
      "name": "10 - Users",
      "request": { "method": "GET", "url": "{{baseUrl}}/users/" },
      "event": [{ "listen": "test", "script": { "exec": [
        "const allowed = pm.collectionVariables.get('currentRole') === 'Administrator';",
        "pm.test('Status matches administrator authorization', () => pm.response.to.have.status(allowed ? 200 : 403));",
        "pm.test('Users content matches authorization', () => { const body = pm.response.json(); allowed ? pm.expect(body).to.be.an('array') : pm.expect(body).to.have.property('detail'); });"
      ] } }]
    },
    {
      "name": "11 - Stock",
      "request": { "method": "GET", "url": "{{baseUrl}}/stock/" },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Status 200', () => pm.response.to.have.status(200));",
        "pm.test('Stock response is an array', () => pm.expect(pm.response.json()).to.be.an('array'));"
      ] } }]
    },
    {
      "name": "12 - Purchase orders",
      "request": { "method": "GET", "url": "{{baseUrl}}/purchase-orders/" },
      "event": [{ "listen": "test", "script": { "exec": [
        "const allowed = ['Administrator', 'Warehouse Staff'].includes(pm.collectionVariables.get('currentRole'));",
        "pm.test('Status matches warehouse authorization', () => pm.response.to.have.status(allowed ? 200 : 403));",
        "pm.test('Purchase orders content matches authorization', () => { const body = pm.response.json(); allowed ? pm.expect(body).to.be.an('array') : pm.expect(body).to.have.property('detail'); });"
      ] } }]
    },
    {
      "name": "13 - Goods receipts",
      "request": { "method": "GET", "url": "{{baseUrl}}/grns/" },
      "event": [{ "listen": "test", "script": { "exec": [
        "const allowed = ['Administrator', 'Warehouse Staff'].includes(pm.collectionVariables.get('currentRole'));",
        "pm.test('Status matches warehouse authorization', () => pm.response.to.have.status(allowed ? 200 : 403));",
        "pm.test('GRN content matches authorization', () => { const body = pm.response.json(); allowed ? pm.expect(body).to.be.an('array') : pm.expect(body).to.have.property('detail'); });"
      ] } }]
    },
    {
      "name": "14 - Sales orders",
      "request": { "method": "GET", "url": "{{baseUrl}}/sales-orders/" },
      "event": [{ "listen": "test", "script": { "exec": [
        "const allowed = ['Administrator', 'Logistics Staff'].includes(pm.collectionVariables.get('currentRole'));",
        "pm.test('Status matches logistics authorization', () => pm.response.to.have.status(allowed ? 200 : 403));",
        "pm.test('Sales orders content matches authorization', () => { const body = pm.response.json(); allowed ? pm.expect(body).to.be.an('array') : pm.expect(body).to.have.property('detail'); });"
      ] } }]
    },
    {
      "name": "15 - Delivery challans",
      "request": { "method": "GET", "url": "{{baseUrl}}/delivery-challans/" },
      "event": [{ "listen": "test", "script": { "exec": [
        "const allowed = ['Administrator', 'Logistics Staff'].includes(pm.collectionVariables.get('currentRole'));",
        "pm.test('Status matches logistics authorization', () => pm.response.to.have.status(allowed ? 200 : 403));",
        "pm.test('Delivery challans content matches authorization', () => { const body = pm.response.json(); allowed ? pm.expect(body).to.be.an('array') : pm.expect(body).to.have.property('detail'); });"
      ] } }]
    }
  ]
}
